{
  "name": "Score successfully found",
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPathEqualTo": "/scores/[0-9]{11}"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\n  \"cpf\": \"{{request.pathSegments.[1]}}\",\n  \"score\": {{randomInt lower=700 upper=950}},\n }",
    "transformers": [
      "response-template"
    ]
  }
}